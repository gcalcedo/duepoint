# --- Portal worker -------------------------------------------------------------
# scripted : hand-written Playwright flow per portal (deterministic; used by tests)
# codex    : a Codex agent works each portal through MCP browser tools (the real demo)
AGENT_MODE=scripted

# Which MCP server gives the Codex agent its browser.
#   playwright : Playwright MCP + local Chromium (default; no credits, works on localhost)
#   solari     : Solari's hosted MCP → Solari cloud browsers (needs SOLARI_API_KEY and a
#                publicly reachable PUBLIC_BASE_URL, since the cloud browser must reach the portals)
# BROWSER_MCP=playwright

# Codex authenticates from your local Codex login (`codex login`, ChatGPT subscription) or
# CODEX_API_KEY. Optional overrides:
# CODEX_MODEL=gpt-5.6-sol
# CODEX_REASONING_EFFORT=medium

# --- Browser for the scripted flows and for posting to Corvus AR -------------------
EXECUTION_PROVIDER=local
# EXECUTION_PROVIDER=solari
# SOLARI_API_KEY=slr_live_your_key_here

# Public URL of the portals + Corvus AR (required for any Solari browser).
# `npm run host:start` hosts them in a Solari sandbox and writes PUBLIC_BASE_URL to .env.solari.
# PUBLIC_BASE_URL=https://....preview.getsolari.com
# HOST_TIMEOUT_MIN=180

# Visible, deliberately paced browsers — one window per customer portal.
# DEMO_MODE=visible
